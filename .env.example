# ==============================================================================
# White-Label Marquee Independent Deployment Configuration
# Each marquee client receives an independent Firebase project & custom domain.
# Duplicate this file to .env.local and populate with client-specific credentials.
# ==============================================================================

# Client Firebase Web App Configuration
VITE_FIREBASE_API_KEY=AIzaSyA_ExampleClientApiKey123456789
VITE_FIREBASE_AUTH_DOMAIN=client-marquee-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=client-marquee-prod
VITE_FIREBASE_STORAGE_BUCKET=client-marquee-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional Cloud Functions Emulator / Base URL (for trusted server-side conflict checks)
VITE_FUNCTIONS_BASE_URL=

# Default Marquee Profile Identifiers (Optional overrides)
VITE_DEFAULT_VENUE_NAME="Elysian Grand Marquee & Banquets"
VITE_ENABLE_DEMO_DATA=true
